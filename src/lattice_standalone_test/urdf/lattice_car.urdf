<robot name="lattice_car">
  <!-- Vehicle dimensions: 3.0m x 1.6m, chassis height 1.5m -->
  <material name="chassis_color">
    <color rgba="0.2 0.4 0.9 1.0"/>
  </material>
  <material name="black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>
  <material name="red">
    <color rgba="0.8 0.1 0.1 1.0"/>
  </material>

  <!-- base_footprint: projection on ground plane, moved by TF -->
  <link name="base_footprint"/>

  <!-- chassis -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="3.0 1.6 1.5"/>
      </geometry>
      <material name="chassis_color"/>
    </visual>
  </link>

  <joint name="base_to_footprint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.95"/>  <!-- half chassis height + ground clearance -->
  </joint>

  <!-- 4 wheels: cylinders r=0.35 w=0.25 -->
  <link name="wheel_fl">
    <visual>
      <geometry>
        <cylinder radius="0.35" length="0.25"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>
  <link name="wheel_fr">
    <visual>
      <geometry>
        <cylinder radius="0.35" length="0.25"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>
  <link name="wheel_rl">
    <visual>
      <geometry>
        <cylinder radius="0.35" length="0.25"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>
  <link name="wheel_rr">
    <visual>
      <geometry>
        <cylinder radius="0.35" length="0.25"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>

  <!-- front-left wheel: at chassis bottom, cylinder axis along Y (car left-right) -->
  <joint name="fl_joint" type="fixed">
    <parent link="base_link"/>
    <child link="wheel_fl"/>
    <origin xyz="1.0 0.9 -0.65" rpy="1.5708 0 0"/>
  </joint>
  <!-- front-right wheel -->
  <joint name="fr_joint" type="fixed">
    <parent link="base_link"/>
    <child link="wheel_fr"/>
    <origin xyz="1.0 -0.9 -0.65" rpy="1.5708 0 0"/>
  </joint>
  <!-- rear-left wheel -->
  <joint name="rl_joint" type="fixed">
    <parent link="base_link"/>
    <child link="wheel_rl"/>
    <origin xyz="-1.0 0.9 -0.65" rpy="1.5708 0 0"/>
  </joint>
  <!-- rear-right wheel -->
  <joint name="rr_joint" type="fixed">
    <parent link="base_link"/>
    <child link="wheel_rr"/>
    <origin xyz="-1.0 -0.9 -0.65" rpy="1.5708 0 0"/>
  </joint>
</robot>
