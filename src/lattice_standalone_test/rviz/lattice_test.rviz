Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.6
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Name: Grid
      Plane Cell Count: 100
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
    - Alpha: 0.7
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 0; 100; 255
      Enabled: true
      Name: Reference Path
      Offset:
        X: 0
        Y: 0
        Z: 0
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /lattice_test/reference_path
      Value: true
    - Alpha: 1.0
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 0; 255; 0
      Enabled: true
      Name: Optimal Trajectory
      Offset:
        X: 0
        Y: 0
        Z: 0
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /lattice_test/optimal_trajectory
      Value: true
    - Alpha: 0.4
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 128; 128; 128
      Enabled: true
      Name: Candidate Trajectories
      Offset:
        X: 0
        Y: 0
        Z: 0
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /lattice_test/candidate_trajectories
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Visualization Markers
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /lattice_test/viz_markers
      Value: true
  Enabled: true
  Global Options:
    Background Color: 30; 30; 30
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: TopDownOrtho
      Near Clip Distance: 0.1
      Scale: 10
      Target Frame: <Fixed Frame>
      Value: TopDownOrtho (rviz_default_plugins)
      X: 20
      Y: 0
    Saved: {}
Window Geometry:
  Height: 800
  Width: 1200
